# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio ni uses el prefijo VITE_ en estas claves:
# solo las leen el backend y los scripts de Node, jamás el cliente.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini usado por el backend y por la prueba de humo.
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: modelo usado solo en el reintento cuando el principal responde 503.
# Si se deja vacía o no existe, el reintento usa GEMINI_MODEL.
GEMINI_MODEL_RESPALDO=

# Configuración local del servidor de desarrollo (no se usa en Vercel).
PORT=3001
API_PROXY_TARGET=http://localhost:3001
LANGUAGETOOL_URL=https://api.languagetool.org

# PostgreSQL local para cuentas y documentos.
# Crea la base con: createdb -U postgres editor_tutor
# Después aplica el esquema con: npm run db:init
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/editor_tutor

# Secreto para firmar los tokens de sesión. Usa una cadena aleatoria de al
# menos 32 caracteres y no lo compartas. Puedes generarlo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

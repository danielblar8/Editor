# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio ni uses el prefijo VITE_ en estas claves:
# solo las leen el backend y los scripts de Node, jamás el cliente.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini usado por el backend y por la prueba de humo.
GEMINI_MODEL=gemini-3.5-flash-lite

# Configuración local del servidor de desarrollo (no se usa en Vercel).
PORT=3001
API_PROXY_TARGET=http://localhost:3001
LANGUAGETOOL_URL=https://api.languagetool.org

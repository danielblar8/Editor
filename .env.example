# Copia este archivo como .env y completa los valores.
# NUNCA subas .env al repositorio ni uses el prefijo VITE_ en estas claves:
# este proceso solo se lee desde scripts de Node, jamás desde el cliente.

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Gemini usado por el script de prueba de humo.
GEMINI_MODEL=gemini-2.5-flash
